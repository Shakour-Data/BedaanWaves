{
  "dashboard": {
    "title": "BedaanWaves - Platform Overview",
    "description": "High-level platform health dashboard for executives and managers",
    "tags": ["bedaanwaves", "platform", "executive"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Platform Health",
        "type": "stat",
        "gridPos": {"h": 3, "w": 6, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "Healthy", "color": "green"}}, "type": "value"},
              {"options": {"1": {"text": "Degraded", "color": "yellow"}}, "type": "value"},
              {"options": {"2": {"text": "Unhealthy", "color": "red"}}, "type": "value"}
            ],
            "thresholds": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 2}
            ]
          }
        },
        "targets": [
          {
            "expr": "avg(bedaanwaves_health_status)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Total Requests (5m)",
        "type": "stat",
        "gridPos": {"h": 3, "w": 6, "x": 6, "y": 0},
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "mappings": []
          }
        },
        "targets": [
          {
            "expr": "sum(rate(bedaanwaves_requests_total[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 3},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": [
              {"color": "green", "value": 0.01},
              {"color": "yellow", "value": 0.03},
              {"color": "red", "value": 0.05}
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(bedaanwaves_requests_total{status=~\"5..\"}[5m])) / sum(rate(bedaanwaves_requests_total[5m])) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "95th Percentile Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 3},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": [
              {"color": "green", "value": 0.5},
              {"color": "yellow", "value": 1.0},
              {"color": "red", "value": 2.0}
            ]
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(bedaanwaves_request_latency_seconds_bucket[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "CPU Usage",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 11},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": [
              {"color": "green", "value": 0.7},
              {"color": "yellow", "value": 0.85},
              {"color": "red", "value": 0.95}
            ]
          }
        },
        "targets": [
          {
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 11},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": [
              {"color": "green", "value": 0.7},
              {"color": "yellow", "value": 0.85},
              {"color": "red", "value": 0.95}
            ]
          }
        },
        "targets": [
          {
            "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Disk Usage",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 11},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": [
              {"color": "green", "value": 0.8},
              {"color": "yellow", "value": 0.9},
              {"color": "red", "value": 0.95}
            ]
          }
        },
        "targets": [
          {
            "expr": "(1 - node_filesystem_avail_bytes / node_filesystem_size_bytes) * 100",
            "refId": "A"
          }
        ]
      }
    ]
  }
}