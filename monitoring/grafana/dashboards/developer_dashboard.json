{
  "dashboard": {
    "title": "BedaanWaves - Developer Dashboard",
    "description": "Detailed metrics for development and debugging",
    "tags": ["bedaanwaves", "developer", "debugging"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(bedaanwaves_requests_total[5m])) by (endpoint)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Error Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "fieldConfig": {
          "defaults": {
            "thresholds": [
              {"color": "green", "value": 0.01},
              {"color": "yellow", "value": 0.03},
              {"color": "red", "value": 0.05}
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(bedaanwaves_requests_total{status=~\"5..\"}[5m])) by (endpoint) / sum(rate(bedaanwaves_requests_total[5m])) by (endpoint) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Latency Heatmap",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(bedaanwaves_request_latency_seconds_bucket[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 3, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "bedaanwaves_active_connections",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Cache Hit Rate",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 19},
        "targets": [
          {
            "expr": "sum(rate(bedaanwaves_cache_hits_total[5m])) / (sum(rate(bedaanwaves_cache_hits_total[5m])) + sum(rate(bedaanwaves_cache_misses_total[5m]))) * 100",
            "refId": "A"
          }
        ]
      }
    ]
  }
}