# =============================================================================
# BedaanWaves — Docker Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.docker` and adjust secrets before first run:
#   cp .env.docker.example .env.docker
# docker compose --env-file .env.docker up --build -d
#
# NOTE: `.env.docker` is in .gitignore — never commit real secrets.
# =============================================================================

# --- PostgreSQL (service container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=bedaanwaves_db

# Use the SYNC postgresql:// form — base.py auto-converts to +asyncpg internally
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/bedaanwaves_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=True

# --- Backend app ---
APP_NAME=BedaanWaves
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production
API_PORT=3000
API_HOST=0.0.0.0
API_V1_STR=/api/v1

# Use the SYNC postgresql:// form — base.py auto-converts to +asyncpg internally
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Secrets (generate strong values in production) ---
# python -c "from secrets import token_urlsafe; print(token_urlsafe(48))"
SECRET_KEY=replace_with_strong_random_secret_min_64_chars_long
JWT_SECRET=replace_with_strong_random_secret_min_64_chars_long
REQUIRE_AUTH=True
ALGORITHM=HS256

# --- Auth public paths (unauthenticated) ---
AUTH_PUBLIC_PATHS=["/", "/health", "/api/v1/data-health"]
AUTH_PUBLIC_PREFIXES=["/api/v1/auth", "/api/v1/docs", "/api/v1/redoc", "/api/v1/openapi.json", "/api/v1/market", "/api/v1/analysis", "/api/v1/news"]

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# --- CORS (frontend origin in production) ---
CORS_ORIGINS=["http://localhost:3005", "http://127.0.0.1:3005", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True

# --- Data Provider ---
DATA_PROVIDER=yfinance
DATA_PROVIDER_TIMEOUT=15
DATA_PROVIDER_MAX_RETRIES=3
YFINANCE_ENABLED=True

# --- ML ---
ML_ENABLED=True
ML_MODEL_PATH=./models

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# --- Email (password recovery) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bedaanwaves.example
EMAILS_ENABLED=False
