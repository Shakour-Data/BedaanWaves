# BedaanWaves Nginx Reverse Proxy + Load Balancer
# Path: /etc/nginx/sites-available/bedaanwaves
# Usage: symlink to /etc/nginx/sites-enabled/ and run `nginx -t && systemctl reload nginx`

# Upstream: multiple uvicorn workers for horizontal scaling
# Start workers on separate ports:
#   uvicorn app.main:app --workers 4 --host 127.0.0.1 --port 3000
#   uvicorn app.main:app --workers 4 --host 127.0.0.1 --port 3001
#   uvicorn app.main:app --workers 4 --host 127.0.0.1 --port 3002

upstream bedaanwaves_backend {
    server 127.0.0.1:3000 max_fails=3 fail_timeout=30s;
    server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
    server 127.0.0.1:3002 max_fails=3 fail_timeout=30s;
    keepalive 64;
}

# Rate limiting zone (defined in http block of nginx.conf)
# limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name api.bedaanwaves.com www.api.bedaanwaves.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.bedaanwaves.com www.api.bedaanwaves.com;

    # SSL certificates (replace with your paths)
    ssl_certificate     /etc/ssl/certs/bedaanwaves.crt;
    ssl_certificate_key /etc/ssl/private/bedaanwaves.key;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5:!DES:!RC4;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header X-Download-Options "noopen" always;

    # Request size limits
    client_max_body_size 16M;
    client_body_timeout 30s;
    client_header_timeout 30s;

    # Logging
    access_log /var/log/nginx/bedaanwaves_access.log;
    error_log  /var/log/nginx/bedaanwaves_error.log warn;

    # Rate limiting (applied to API paths only)
    location /api/v1/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://bedaanwaves_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Original-URI $request_uri;

        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # WebSocket support for live SSE endpoints
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    # Health check endpoint (no rate limiting)
    location /health {
        proxy_pass http://bedaanwaves_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # Static assets with long-term caching
    location /_next/static/ {
        proxy_pass http://bedaanwaves_backend;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /static/ {
        proxy_pass http://bedaanwaves_backend;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
    }

    # Block access to sensitive paths
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(env|ini|sh|sql|log|md|yml|yaml)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}