# =============================================================================
# BedaanWaves - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values
# This configuration is optimized for native Windows development (No Docker)
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=BedaanWaves
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# =============================================================================
# DATABASE - PostgreSQL (Native Windows Installation)
# =============================================================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bedaanwaves_db

# Individual components (used by application)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bedaanwaves_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Connection Pool Settings
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# REDIS & CACHE (Native Windows Installation)
# =============================================================================
# Format: redis://host:port/database
REDIS_URL=redis://localhost:6379/0

# Cache Settings
CACHE_ENABLED=True
CACHE_BACKEND=redis
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_TTL_MINUTES=60
CACHE_SCORE_TTL_HOURS=24
CACHE_API_RESPONSE_TTL_MINUTES=5
SYMBOL_CACHE_TTL=3600

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_V1_STR=/api/v1
API_BASE_PATH=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=1.0.0
API_TITLE=BedaanWaves API
API_TIMEOUT=30
API_MAX_CONNECTIONS=100

# Documentation URLs
DOCS_URL=/api/v1/docs
REDOC_URL=/api/v1/redoc
OPENAPI_URL=/api/v1/openapi.json
ENABLE_DOCS=True

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# IMPORTANT: Change these to strong, random keys for production!
SECRET_KEY=generate-a-very-strong-secret-key-minimum-64-characters-long-here
JWT_SECRET=generate-another-very-strong-jwt-secret-minimum-64-characters-here

ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
ENABLE_HTTPS=False
REQUIRE_AUTH=False

# Public paths that don't require authentication
AUTH_PUBLIC_PATHS=["/", "/health", "/docs", "/redoc", "/openapi.json"]
AUTH_PUBLIC_PREFIXES=["/api/v1/auth", "/api/v1/docs", "/api/v1/redoc", "/api/v1/openapi.json"]

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3005", "http://127.0.0.1:3005"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=True
LOG_FILE_PATH=./logs/bedaanwaves.log
LOG_ROTATION=midnight
LOG_RETENTION_DAYS=30
METRICS_ENABLED=True

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_FORECASTING=True
ENABLE_COMPARISON=True
ENABLE_ALERTS=True
ENABLE_ADVANCED_ANALYTICS=True

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Never commit the actual .env file to version control
# 2. Keep backup of your .env file in a secure location
# 3. For production, use strong, randomly generated keys
# 4. Ensure PostgreSQL and Redis services are running before starting the application
# 5. Update the DB_PASSWORD and other secrets before running the application
# =============================================================================
