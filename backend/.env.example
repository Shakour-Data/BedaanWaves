# Application
APP_NAME=BedaanWaves
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://postgres:YOUR_SECURE_DB_PASSWORD@localhost:5432/bedaanwaves_db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis & Cache
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
CACHE_TTL_MINUTES=60
CACHE_SCORE_TTL_HOURS=24
CACHE_API_RESPONSE_TTL_MINUTES=5

# API Configuration
API_V1_STR=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=BedaanWaves Unified Capital Market Platform
DOCS_URL=/api/v1/docs
OPENAPI_URL=/api/v1/openapi.json

# Security & Authentication
SECRET_KEY=GENERATE_A_STRONG_RANDOM_SECRET_KEY_MIN_64_CHARS
JWT_SECRET=GENERATE_A_STRONG_RANDOM_JWT_SECRET_MIN_64_CHARS
REQUIRE_AUTH=True
DEBUG=False
ALGORITHM=HS256
AUTH_PUBLIC_PATHS=["/", "/health", "/docs", "/redoc", "/openapi.json"]
AUTH_PUBLIC_PREFIXES=["/api/v1/auth", "/api/v1/docs", "/api/v1/redoc", "/api/v1/openapi.json"]

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3005", "http://127.0.0.1:3005"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
CORS_ALLOW_HEADERS=["*"]

# External APIs
# Tehran Stock Exchange (BrsApi.ir)
BRS_API_BASE_URL=https://Api.BrsApi.ir
BRS_API_KEY=your_brs_api_key_here
BRS_API_TIMEOUT=30
BRS_REFRESH_INTERVAL_MINUTES=5
BRS_RATE_LIMIT_MAX_DAILY=50000
BRS_RATE_LIMIT_MAX_WINDOW=300
BRS_RATE_LIMIT_WINDOW_SECONDS=300

# Financial Disclosures (Codal)
CODAL_API_BASE_URL=https://api.codal.ir
CODAL_API_KEY=your_codal_api_key_here
CODAL_REFRESH_INTERVAL_HOURS=24

# External Financial APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# News APIs
NEWS_SOURCES=["tehran-news", "financial-news", "market-news"]
NEWS_REFRESH_INTERVAL_MINUTES=30

# Cryptocurrency APIs
CRYPTO_ENABLED=True
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
BINANCE_API_BASE_URL=https://api.binance.com/api/v3
CRYPTO_REFRESH_INTERVAL_MINUTES=5

# Crypto Settings
CRYPTO_SUPPORT_ENABLED=True
CRYPTO_PORTFOLIOS_ENABLED=True
CRYPTO_ALERTS_ENABLED=True
SUPPORTED_CRYPTOCURRENCIES=["BTC", "ETH", "BNB", "XRP", "SOL", "ADA", "DOT", "DOGE", "MATIC", "UNI", "LINK", "AVAX", "FTM", "ATOM"]

# ML Configuration
ML_ENABLED=True
ML_MODEL_PATH=./models
ML_MODELS_VERSION=1.0.0
ML_TRAINING_ENABLED=True
ML_UPDATE_INTERVAL_HOURS=1
ML_RETRAINING_INTERVAL_DAYS=7
ML_SIGNAL_THRESHOLD=0.65
ML_CONFIDENCE_THRESHOLD=0.60
ML_PREDICTION_CONFIDENCE_WEIGHTS={"random_forest": 0.20, "xgboost": 0.25, "lightgbm": 0.25, "neural_network": 0.20, "svm": 0.10}
ML_LOOKBACK_DAYS=252
ML_FEATURES_NORMALIZATION=zscore

# Technical Analysis
TECHNICAL_ANALYSIS_ENABLED=True
TECHNICAL_INDICATORS_COUNT=50
TECHNICAL_SMA_PERIODS=[20, 50, 200]
TECHNICAL_EMA_PERIODS=[12, 26]
TECHNICAL_RSI_PERIOD=14
TECHNICAL_MACD_FAST=12
TECHNICAL_MACD_SLOW=26
TECHNICAL_MACD_SIGNAL=9
TECHNICAL_BOLLINGER_PERIOD=20
TECHNICAL_BOLLINGER_STD_DEV=2.0
TECHNICAL_ATR_PERIOD=14

# NLP & Sentiment Analysis
NLP_ENABLED=True
SENTIMENT_ANALYSIS_ENABLED=True
PERSIAN_STOPWORDS_ENABLED=True
PERSIAN_LEMMATIZATION_ENABLED=True
SENTIMENT_MODEL_PATH=./models/sentiment_model.pkl
SENTIMENT_KEYWORDS_PATH=./data/sentiment_keywords.json
SENTIMENT_IMPACT_THRESHOLD=0.5

# Portfolio & Risk Management
PORTFOLIO_ENABLED=True
PORTFOLIO_OPTIMIZATION_ENABLED=True
PORTFOLIO_MIN_POSITION_SIZE=0.01
PORTFOLIO_MAX_POSITION_SIZE=0.10
PORTFOLIO_MAX_CONCENTRATION=0.30
RISK_MANAGEMENT_ENABLED=True
PORTFOLIO_VAR_CONFIDENCE=0.95
PORTFOLIO_MAX_DRAWDOWN=0.20
PORTFOLIO_VOLATILITY_TARGET=0.15

# Portfolio Constraints
PORTFOLIO_MIN_POSITION_SIZE=0.01
PORTFOLIO_MAX_POSITION_SIZE=0.10
PORTFOLIO_MAX_CONCENTRATION=0.30

# Risk Management
PORTFOLIO_VAR_CONFIDENCE=0.95
PORTFOLIO_MAX_DRAWDOWN=0.20
PORTFOLIO_VOLATILITY_TARGET=0.15

# Alerts & Notifications
ALERTS_ENABLED=True
ALERT_TYPES=["price_change", "technical_signal", "portfolio_alert", "ml_prediction", "sentiment_shift", "anomaly_detection", "risk_warning"]
NOTIFICATIONS_EMAIL_ENABLED=True
NOTIFICATIONS_SMS_ENABLED=False
NOTIFICATIONS_PUSH_ENABLED=False
NOTIFICATIONS_WEBHOOK_ENABLED=True

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=True
LOG_FILE_PATH=./logs/bedaanwaves.log
LOG_ROTATION=midnight
LOG_RETENTION_DAYS=30
METRICS_ENABLED=True
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_METRICS_PORT=9090

# Data Persistence & Backup
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups
ARCHIVE_PATH=./data/archive

# Crypto Settings
CRYPTO_PORTFOLIOS_ENABLED=True
CRYPTO_ALERTS_ENABLED=True