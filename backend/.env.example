# =============================================================================
# BedaanWaves Backend Environment Configuration
# Native Windows Development (No Docker)
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=BedaanWaves
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# =============================================================================
# Database Configuration (PostgreSQL - Native Windows)
# =============================================================================
# For local PostgreSQL installation on Windows
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bedaanwaves_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Full database URL (constructed from above or provide directly)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/bedaanwaves_db

# Connection Pool Settings
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis & Cache Configuration (Native Windows)
# =============================================================================
# For local Redis installation on Windows (Memurai or redis-windows)
REDIS_URL=redis://localhost:6379/0

# Cache Settings
CACHE_ENABLED=True
CACHE_BACKEND=redis
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_TTL_MINUTES=60
CACHE_SCORE_TTL_HOURS=24
CACHE_API_RESPONSE_TTL_MINUTES=5
SYMBOL_CACHE_TTL=3600

# Real-Time Data Cache TTLs
REALTIME_QUOTE_CACHE_TTL_SECONDS=10
HISTORICAL_DATA_CACHE_TTL_SECONDS=3600
INTRADAY_DATA_CACHE_TTL_SECONDS=120
MARKET_STATUS_CACHE_TTL_SECONDS=60

# =============================================================================
# Data Provider Configuration
# =============================================================================
DATA_PROVIDER=yfinance
DATA_PROVIDER_FALLBACK_ENABLED=False
DATA_PROVIDER_TIMEOUT=15
DATA_PROVIDER_MAX_RETRIES=3
DATA_PROVIDER_RETRY_BACKOFF_BASE=1.0
YFINANCE_ENABLED=True

# =============================================================================
# Market Hours (NASDAQ)
# =============================================================================
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0
PRE_MARKET_START_HOUR=4
PRE_MARKET_START_MINUTE=0
AFTER_HOURS_END_HOUR=20
AFTER_HOURS_END_MINUTE=0
WEEKEND_CLOSED=True

# =============================================================================
# API Configuration
# =============================================================================
API_V1_STR=/api/v1
API_BASE_PATH=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=1.0.0
API_TITLE=BedaanWaves API
API_TIMEOUT=30
API_MAX_CONNECTIONS=100
DOCS_URL=/api/v1/docs
REDOC_URL=/api/v1/redoc
OPENAPI_URL=/api/v1/openapi.json
ENABLE_DOCS=True

# =============================================================================
# Security & Authentication
# =============================================================================
# IMPORTANT: Change these to strong random values in production!
SECRET_KEY=dev-secret-key-change-in-production-min-64-chars-long
JWT_SECRET=dev-jwt-secret-change-in-production-min-64-chars-long
ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
ENABLE_HTTPS=False
REQUIRE_AUTH=False

# Public paths (no authentication required)
AUTH_PUBLIC_PATHS=["/", "/health", "/docs", "/redoc", "/openapi.json"]
AUTH_PUBLIC_PREFIXES=["/api/v1/auth", "/api/v1/docs", "/api/v1/redoc", "/api/v1/openapi.json"]

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3005", "http://127.0.0.1:3005"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# Logging & Monitoring
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=True
LOG_FILE_PATH=./logs/bedaanwaves.log
LOG_ROTATION=midnight
LOG_RETENTION_DAYS=30
METRICS_ENABLED=True
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_METRICS_PORT=9090
